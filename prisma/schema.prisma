// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            String  @id //id churros
  name          String

  group         GroupClub[] @relation("UserGroups")// Club auquel l'utilisateur appartient
  groupBoard    GroupClub[] @relation("BoardGroups")// Bureau du club auquel l'utilisateur appartient

  groupInte     GroupInte? @relation("UserGroupInte", fields: [groupInteId], references: [groupId]) // Groupe d'intégration 
  groupInteId   String?
  points        Int    @default(0)   // Points gagnés par l'utilisateur
  proof         Proof[] @relation("UserProofs") // Preuves envoyées par l'utilisateur

  isAdmin       Boolean @default(false) // Indique si l'utilisateur est un admin
}



model GroupClub {
  //récuperer de churros
  groupId    String   @id
  name       String
  pictureURL String?      // image du groupe 
  type       String       // type de groupe (club, groupe d'integration)

  users      User[]   @relation("UserGroups")
  board     User[]   @relation("BoardGroups")
  challenge Challenge[]   @relation("GroupChallenges")
}

model GroupInte {
  //récuperer de churros
  groupId    String   @id
  name       String
  pictureURL String?      // image du groupe 
  type       String       // type de groupe (club, groupe d'integration)

  usersInte  User[]   @relation("UserGroupInte")
  challengeSucceed    Challenge[] @relation("ChallengesSucceed")
  points Int      @default(0)
}

model Proof {
  proofId   String      @id @default(uuid())

  //qui a envoyé la preuve
  user       User    @relation("UserProofs", fields: [userId], references: [id])
  userId     String

  content    String   //contenu de la preuve (lien vers le media)
  type       String   //type de preuve (photo / video / text)
  date       DateTime //date d'envoi de la preuve

  media      String?  //lien vers le média (si type est photo ou video)
  text       String?  //texte de la preuve (si type est texte)

  challenge  Challenge? @relation("ChallengeProofs", fields: [challengeId], references: [challengeId]) //challenge auquel la preuve est liée
  challengeId String?
  
  validatorId String?
  status     String   //statut de la preuve (pending / valid / denied) 
}

model Challenge {
  challengeId        String  @id
  name      String
  description String?
  
  // Quel club propose le défi
  group     GroupClub    @relation("GroupChallenges", fields: [groupId], references: [groupId])
  groupId   String

  // Qui a proposé le défi
  userId     String

  // Qui a accepté la proposition de défi
  userAcceptId     String
  defiAccepte Boolean  @default(false)

  // Quel groupe d'inté à reussi le defi
  groupInteSucceed GroupInte[] @relation("ChallengesSucceed")

  type       String   //type de défi (photo / video / text)

  nbPoints  Int      @default(0) 
  difficulty  Int      @default(0)

  // Ou ce situe le défi
  locationName    String   @default("ENSEEIHT")
  location     Location    @relation("DefiPlace", fields: [locationName], references: [name])
  proofs     Proof[] @relation("ChallengeProofs")
}


model Location {
  name  String @id
  challenge Challenge[] @relation("DefiPlace")
}