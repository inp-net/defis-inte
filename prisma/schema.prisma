// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadType {
  PHOTO
  VIDEO
  TEXT
}

enum Status {
  PENDING
  VALID
  DENIED
}

model User {
  id   String  @id @default(uuid()) //id churros
  name String
  is1A Boolean
  profilePictureURL String?      // image de profil de l'utilisateur


  // Dans quel club / bureau de club fait-il partie ?
  group      GroupClub[] @relation("UserGroups")
  groupBoard GroupClub[] @relation("BoardGroups")

  // Dans quel groupe d'intégration fait-il partie ?
  groupInte   GroupInte? @relation("UserGroupInte", fields: [groupInteId], references: [groupId])
  groupInteId String?

  // Combien de points a-t-il ?
  points Int @default(0)

  // Quelles preuves a-t-il soumis ?
  proof Proof[] @relation("UserProofs")

  // Est-il admin ?
  isAdmin Boolean @default(false)
}

model GroupClub {
  // Données de Churros
  groupId    String  @id
  name       String
  pictureURL String? // image du groupe 

  // Qui fait partie du club ?
  users User[] @relation("UserGroups")

  // Qui est au bureau du club ?
  board User[] @relation("BoardGroups")

  // Quels défis sont liés au club ?
  challenge Challenge[] @relation("GroupChallenges")
}

model GroupInte {
  // Données de Churros
  groupId    String  @id
  name       String
  pictureURL String? // image du groupe 

  // Qui fait partie du groupe d'inté ?
  usersInte User[] @relation("UserGroupInte")

  // Quels défis ont été validés par le groupe ?
  challengeSucceed Challenge[] @relation("ChallengesSucceed")

  // Combien de points a le groupe ?
  points Int @default(0)
}

model Proof {
  proofId Int @id @default(autoincrement())

  // Qui a envoyé la preuve ?
  user   User   @relation("UserProofs", fields: [userId], references: [id])
  userId String

  // Quel est le contenu de la preuve ? 
  content String[]  // lien si media ou contenu si texte
  type    UploadType // (photo / video / text)
  date    DateTime

  // A quel défi est reliée la preuve ?
  challenge   Challenge? @relation("ChallengeProofs", fields: [challengeId], references: [challengeId])
  challengeId Int?

  // Qui a validé la preuve ?
  validatorId String?

  // Dans quel statut est la preuve ?
  status Status @default(PENDING)// (pending / valid / denied) 

  // Céder droit a l'image à TVn7
  isOkTVn7 Boolean @default(false) 
}

model Challenge {
  challengeId Int     @id @default(autoincrement())
  name        String
  description String?

  // Quel club propose le défi ?
  group   GroupClub @relation("GroupChallenges", fields: [groupId], references: [groupId])
  groupId String

  // Qui a proposé le défi ?
  userId  String

  // Qui a accepté la proposition de défi ?
  userAcceptId String?
  defiAccepte  Boolean @default(false)

  // Quel groupe d'inté à réussi le defi ?
  groupInteSucceed GroupInte[] @relation("ChallengesSucceed")

  type UploadType

  // Que vaut le défi ?
  nbPoints   Int        @default(0)

  // Où se situe le défi ?
  locationName String   @default("ENSEEIHT")
  location     Location @relation("DefiPlace", fields: [locationName], references: [name])

  // Quelles preuves sont liées à ce défi ?
  proofs Proof[] @relation("ChallengeProofs")

  // Si un admin décide de delete le challenge, il ne s'affiche pas
  isDeleted Boolean @default(false)
}

model Location {
  name      String      @id
  challenge Challenge[] @relation("DefiPlace")
}
