// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "./generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UploadType {
    PHOTO
    VIDEO
    TEXT
}

enum Status {
    PENDING
    VALID
    DENIED
}

model User {
    id                String          @id  @default(uuid())
    firstName         String
    lastName          String
    is1A              Boolean
    profilePictureURL String?

    // Groupe de l'utilisateur. GroupBoard sont ceux où il est dans le bureau.
    group             GroupClub[]     @relation("UserGroups")
    groupBoard        GroupClub[]     @relation("BoardGroups")

    // Groupe d'intégration utile que pour les 1A
    groupInte         GroupInte?      @relation("UserGroupInte", fields: [groupInteId], references: [groupId])
    groupInteId       String?

    points            Int             @default(0)

    // Preuves soumise par l'utilisateur
    proof             Proof[]         @relation("UserProofs")
    
    // Préférences de l'utilisateur
    darkMode          Boolean         @default(false)
    isOkTVn7          Boolean         @default(true)

    // Si l'utilateur est administrateur
    isAdmin           Boolean         @default(false)
}

// Les clubs et associations de l'ENSEEIHT qui proposent des défis.
model GroupClub {
    groupId           String          @id
    name              String
    pictureURL        String?
    users             User[]          @relation("UserGroups")
    board             User[]          @relation("BoardGroups")
    challenge         Challenge[]     @relation("GroupChallenges")
}

// Les groupes d'intégrations.
model GroupInte {
    groupId           String          @id
    name              String
    pictureURL        String?
    usersInte         User[]          @relation("UserGroupInte")
    challengeSucceed  Challenge[]     @relation("ChallengesSucceed")
}

model Proof {
    proofId           Int             @id @default(autoincrement())
    
    // Qui à envoyé la preuve
    user              User            @relation("UserProofs", fields: [userId], references: [id])
    userId            String

    // Type de contenu (VIDEO / PHOTO / TEXTE)
    type              UploadType
    content           String[]
    date              DateTime

    challenge         Challenge?      @relation("ChallengeProofs", fields: [challengeId], references: [challengeId])
    challengeId       Int?

    // Qui à validé la preuve
    validatorId       String?
    // Status (PENDING / VALID / DENIED)
    status            Status          @default(PENDING)
    // Céder les droits d'images à TVn7
    isOkTVn7          Boolean         @default(false)
    // commentaires sur la preuve
    comment           String?
}

model Challenge {
    challengeId       Int             @id @default(autoincrement())
    name              String
    description       String?

    // Quel asso à proposé le défi
    group             GroupClub       @relation("GroupChallenges", fields: [groupId], references: [groupId])
    groupId           String
    
    // Quel individu à proposé le défi
    userId            String

    // Quel individu à accepté le défi
    userAcceptId      String?
    defiAccepte       Boolean         @default(false)

    // Quels groupe d'inté ont réussi le défi
    // deprecated
    groupInteSucceed  GroupInte[]     @relation("ChallengesSucceed")

    // Type de preuve (VIDEO / TEXTE / PHOTO)
    type              UploadType
    nbPoints          Int             @default(0)

    // Endroit où doit se passe le défi
    locationName      String          @default("ENSEEIHT")
    location          Location        @relation("DefiPlace", fields: [locationName], references: [name])

    // Preuves relatives au challenge
    proofs            Proof[]         @relation("ChallengeProofs")
    isDeleted         Boolean         @default(false)
}

model Location {
    name              String          @id
    challenge         Challenge[]     @relation("DefiPlace")
}
